<div class="w-full bg-[url('/images/background-sun.png')] bg-repeat py-8">
  <div class="flex flex-col items-center">
    <div class="m-8 mb-16 border-[#fab630] border-4 rounded-lg p-4 bg-white">
      <%= link_to "https://dice.fm/event/l866gb-house-of-bamboo-presents-odyssey-12th-jul-tempest-brighton-tickets?lng=en", target: :_blank do %>
        <%= image_tag("Odyssey logo.png", width: 250) %>
        <p class="text-center pt-4 text-[#ef5828] font-[roboto] font-light">Tickets</p>
      <% end %>
