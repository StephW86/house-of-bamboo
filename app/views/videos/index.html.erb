<div
  class="flex flex-col"
  data-controller="play-next-button"
  data-play-next-button-index-value="1"
>
  <div class="flex flex-row">
    <%= video_tag(
      "video_1.mp4",
      size: "320x240",
      controls: true,
      autoplay: true,
      muted: true,
      playsinline: true,` `
      data: { play-next-button-target: "video" }
      ) do %>
      <p>Your browser doesn't support this video. Here's a <a href="<%= asset_path('video_1.mp4') %>">link to the video</a> instead.</p>
    <% end %>
    <%= image_tag 'play_next.svg', width: 100, data: { action: "click->play-next-button#next" } %>
  </div>
  <div>
    <a
      href="https://linktr.ee/houseofbamboo_btn?utm_source=linktree_profile_share&ltsid=bc52003f-35f1-41ef-b83e-19c9c38454f1"
      class="self-end text-sm mt-1 text-blue-900"
    >
      @houseofbamboo_btn
    </a>
  </div>
</div>
