        "/videos/video_1.mp4",
        size: "640x480",
        controls: true,
        autoplay: true,
        muted: true,
        playsinline: true,
        loop: true,
        class: "rounded-lg",
        ) do %>
        <p>Your browser doesn't support this video. Here's a <a href="<%= asset_path('video_1.mp4') %>">link to the video</a> instead.</p>
