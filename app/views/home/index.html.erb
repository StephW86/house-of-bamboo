<% content_for :body_class, 'bg-[#fab631]' %>

<div class='flex flex-col lg:flex-row items-center justify-center gap-4 mb-4 px-4 pt-4'>
  <%= image_tag('us_at_tempest.jpg', class: 'block w-full max-w-[555px] lg:w-1/3') %>
  <%= image_tag('summer_party.jpg', class: 'block w-full max-w-[555px] lg:w-1/3') %>
  <%= image_tag('craig_charles.jpg', class: 'block w-full max-w-[555px] lg:w-1/3') %>
</div>

<% if @upcoming_gigs.any? %>
  <div class='text-center pt-6 pb-0'>
    <p class='inline-block bg-white rounded-lg px-6 py-2 text-2xl font-bold text-[#ef5828] font-[roboto]'>Gigs</p>
  </div>
  <div class='mx-auto mt-12 mb-6 px-8 max-w-[1400px] flex flex-wrap justify-center items-center gap-8'>
    <% @upcoming_gigs.each do |gig| %>
      <div class='w-[424px] max-w-full'>
        <%= render 'shared/card',
          url: gig['url'],
          image: gig['image'],
          alt_text: gig['alt_text'],
          title: gig['title'],
          description: gig['description']
        %>
      </div>
    <% end %>
  </div>
<% end %>

<div class='text-center pt-0 pb-8'>
  <p class='inline-block bg-white rounded-lg px-6 py-2 text-2xl font-bold text-[#ef5828] font-[roboto]'>
    <a href="https://www.mixcloud.com/houseofbamboo_btn/" target="_blank">Mixes and streams ></a>
  </p>
</div>

<div class='text-center pt-0 pb-2'>
  <p class='inline-block bg-white rounded-lg px-6 py-2 text-2xl font-bold text-[#ef5828] font-[roboto]'>Tune of the week</p>
</div>
<div class='text-center pt-0 pb-10'>
  <p class='px-6 py-2 text-2xl font-bold text-[#ef5828] font-[roboto]'>
    'If I Had a Hammer' - Handy Andy (Plaza Records Ltd)
  </p>
</div>

<div class='text-center pt-0 pb-8'>
  <p class='inline-block bg-white rounded-lg px-6 py-2 text-2xl font-bold text-[#ef5828] font-[roboto]'>
    <a href="mailto:houseofbamboo.btn@gmail.com">Contact us ></a>
  </p>
</div>
